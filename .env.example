# ---------------------------------------------------------------------------
# hotstar - environment configuration.
#   Windows PowerShell:  .\scripts\init-env.ps1      (creates .env with fresh random secrets)
#   macOS / Linux:       ./scripts/init-env.sh
# or copy this file to .env and replace every "change-me" value yourself.
# NEVER commit .env.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=hotstar
LOG_LEVEL=INFO

# --- MySQL (one server, six isolated databases / accounts) ---
MYSQL_ROOT_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
USER_DB_PASSWORD=change-me
CONTENT_DB_PASSWORD=change-me
VIDEO_DB_PASSWORD=change-me
WATCHLIST_DB_PASSWORD=change-me
HISTORY_DB_PASSWORD=change-me

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=hotstar-minio
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=hotstar-media

# --- JWT (shared by all services; at least 32 characters) ---
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# --- Seed data (sample catalogue, posters, sample video and the two sample accounts below) ---
SEED_DATA=true
# Sample accounts for LOCAL PRACTICE ONLY - change them or set SEED_DATA=false for anything shared.
ADMIN_EMAIL=admin@hotstar-demo.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=demo@hotstar-demo.com
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=Demo@12345

# --- Browser origins allowed by the gateway (only needed when not using the nginx proxy) ---
CORS_ORIGINS=http://localhost:8080,http://localhost:4200
# Upload limits
MAX_VIDEO_MB=2048
MAX_IMAGE_MB=10
